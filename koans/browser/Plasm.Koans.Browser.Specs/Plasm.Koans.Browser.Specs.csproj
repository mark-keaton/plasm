<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reqnroll host for the browser koans' specifications, driven in a real
       browser with Playwright. Feature files are added slice by slice. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ReqnrollFeatureFiles Include="../features/running-koans.feature;../features/course-experience.feature;../features/database-in-the-browser.feature;../features/pglite-provider.feature;../features/course-in-the-browser.feature" />
    <None Include="../features/running-koans.feature;../features/course-experience.feature;../features/database-in-the-browser.feature;../features/pglite-provider.feature;../features/course-in-the-browser.feature" Link="Features/%(Filename)%(Extension)" />
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Reqnroll.xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm.Koans.Browser.Specs.Steps/Plasm.Koans.Browser.Specs.Steps.fsproj" />
  </ItemGroup>
</Project>
