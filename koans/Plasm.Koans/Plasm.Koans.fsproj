<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Plasm Koans: fill in each blank (__) and run `dotnet run` again. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The oldest FSharp.Core Plasm supports, so notebook kernels with an
         older FSharp.Core can load the koans. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Logging.Abstractions is referenced on purpose (see below), though .NET provides it. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Database.fs" />
    <Compile Include="Lessons/L01_GettingStarted.fs" />
    <Compile Include="Lessons/L02_MeetTheShop.fs" />
    <Compile Include="Lessons/L03_WhatARepoIs.fs" />
    <Compile Include="Lessons/L04_PlasmsPromises.fs" />
    <Compile Include="Lessons/L05_RecordsAndSchemas.fs" />
    <Compile Include="Lessons/L06_QueryValues.fs" />
    <Compile Include="Lessons/L07_FiltersAndOrdering.fs" />
    <Compile Include="Lessons/L08_Reading.fs" />
    <Compile Include="Lessons/L09_Relationships.fs" />
    <Compile Include="Lessons/L10_Changesets.fs" />
    <Compile Include="Lessons/L11_Writes.fs" />
    <Compile Include="Lessons/L12_ChildWrites.fs" />
    <Compile Include="Lessons/L13_Transactions.fs" />
    <Compile Include="Lessons/L14_Joins.fs" />
    <Compile Include="Lessons/L15_AggregatesAndGrouping.fs" />
    <Compile Include="Lessons/L16_ManyToManyAndHasOne.fs" />
    <Compile Include="Lessons/L17_BulkWrites.fs" />
    <Compile Include="Lessons/L18_HandWrittenSql.fs" />
    <Compile Include="Lessons/L19_PreparedQueries.fs" />
    <Compile Include="Lessons/L20_Failures.fs" />
    <Compile Include="Lessons/L21_TestingWithPlasm.fs" />
    <Compile Include="Lessons/L22_QueryPipelines.fs" />
    <Compile Include="Path.fs" />
    <Compile Include="Given.fs" />
    <Compile Include="Notebook.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- What each koan teaches comes from the lesson specifications. -->
    <None Include="$(PkgMicrosoft_Extensions_Logging_Abstractions)/lib/net10.0/Microsoft.Extensions.Logging.Abstractions.dll" Link="Microsoft.Extensions.Logging.Abstractions.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PlasmRoot)koans/features/lessons/*.feature" Link="lessons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(PlasmRoot)koans/Plasm.Koans.Core/Plasm.Koans.Core.fsproj" />
    <ProjectReference Include="$(PlasmRoot)src/Plasm/Plasm.fsproj" />
    <ProjectReference Include="$(PlasmRoot)src/Plasm.Postgres/Plasm.Postgres.fsproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Npgsql" />
    <!-- What Npgsql and Testcontainers reference. .NET 11 provides a newer copy, so
         the build would not copy it; notebook kernels need it next to the koans. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" GeneratePathProperty="true" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
</Project>
