<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Plasm Koans: fill in each blank (__) and run `dotnet run` again. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Database.fs" />
    <Compile Include="Lessons/L01_GettingStarted.fs" />
    <Compile Include="Lessons/L02_WhatARepoIs.fs" />
    <Compile Include="Lessons/L03_MeetTheShop.fs" />
    <Compile Include="Lessons/L04_PlasmsPromises.fs" />
    <Compile Include="Lessons/L05_StoredRecords.fs" />
    <Compile Include="Lessons/L06_QueryValues.fs" />
    <Compile Include="Lessons/L07_FiltersAndOrdering.fs" />
    <Compile Include="Lessons/L08_Reading.fs" />
    <Compile Include="Lessons/L09_AggregatesAndReferences.fs" />
    <Compile Include="Lessons/L10_Writes.fs" />
    <Compile Include="Lessons/L11_ConstructorsAndConstraints.fs" />
    <Compile Include="Lessons/L12_WritingAnAggregate.fs" />
    <Compile Include="Lessons/L13_Transactions.fs" />
    <Compile Include="Lessons/L14_Joins.fs" />
    <Compile Include="Lessons/L15_Loads.fs" />
    <Compile Include="Lessons/L16_AggregatesAndGrouping.fs" />
    <Compile Include="Lessons/L17_LinksAndOwnedRecords.fs" />
    <Compile Include="Lessons/L18_BulkWrites.fs" />
    <Compile Include="Lessons/L19_HandWrittenSql.fs" />
    <Compile Include="Lessons/L20_PreparedQueries.fs" />
    <Compile Include="Lessons/L21_Failures.fs" />
    <Compile Include="Lessons/L22_TestingWithPlasm.fs" />
    <Compile Include="Lessons/L23_UnionsWithFields.fs" />
    <Compile Include="Lessons/L24_SetOperations.fs" />
    <Compile Include="Lessons/L25_WindowsAndRowAggregates.fs" />
    <Compile Include="Lessons/L26_LocksAndTries.fs" />
    <Compile Include="Lessons/L27_WritesThatReturnRows.fs" />
    <Compile Include="Path.fs" />
    <Compile Include="Given.fs" />
    <Compile Include="Course.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- What each koan teaches comes from the lesson specifications. -->
    <None Include="$(PlasmRoot)koans/features/lessons/*.feature" Link="lessons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(PlasmRoot)koans/Plasm.Koans.Core/Plasm.Koans.Core.fsproj" />
    <ProjectReference Include="$(PlasmRoot)src/Plasm/Plasm.fsproj" />
    <ProjectReference Include="$(PlasmRoot)src/Plasm.Postgres/Plasm.Postgres.fsproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
</Project>
