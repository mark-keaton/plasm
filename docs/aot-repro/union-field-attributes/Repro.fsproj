<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Kept whole, so trimming is not the cause. -->
    <NoWarn>$(NoWarn);IL2026;IL2070;IL2075;IL3050;IL2072;IL2067;IL2060;IL2080</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <TrimmerRootAssembly Include="Repro" />
  </ItemGroup>
</Project>
