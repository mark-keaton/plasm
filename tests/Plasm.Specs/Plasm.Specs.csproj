<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reqnroll generates C# test classes from the .feature files; every step is
       implemented in F# in Plasm.Specs.Steps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <!-- The run's database chooses its scenarios: PLASM_TEST_PROVIDER=sqlite runs
       those tagged for SQLite or for neither, else those tagged for PostgreSQL or
       for neither (tests/Plasm.Providers/check-tags.py). A plain dotnet test is
       the PostgreSQL run. -->
  <PropertyGroup>
    <PlasmTestProvider>$(PLASM_TEST_PROVIDER)</PlasmTestProvider>
    <TestingPlatformCommandLineArguments Condition="'$(PlasmTestProvider)' == 'sqlite'">$(TestingPlatformCommandLineArguments) --filter-not-trait Category=postgres</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(PlasmTestProvider)' != 'sqlite'">$(TestingPlatformCommandLineArguments) --filter-not-trait Category=sqlite</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <ReqnrollFeatureFiles Include="../../features/*.feature" />
    <None Include="../../features/*.feature" Link="Features/%(Filename)%(Extension)" />
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Reqnroll.xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm.Specs.Steps/Plasm.Specs.Steps.fsproj" />
  </ItemGroup>
</Project>
