<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native-AOT check (docs/aot.md): run.sh runs this program under the
       runtime and as a native binary, and compares what the two print. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Not PublishAot here: set in a project, it also writes the native
         binary's feature switches (IsDynamicCodeSupported false among them)
         into the runtime build's configuration, and the check compares the
         native binary with the runtime as shipped. The scripts pass it to
         the publish alone. -->
    <DefineConstants Condition="'$(PlasmAotSlim)' == 'true'">$(DefineConstants);PLASM_AOT_SLIM</DefineConstants>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Warnings are errors, as everywhere: six once hid a match that read every
         stage as one. FSharp.Core's two summary lines in a publish are not
         (docs/aot.md); trim-audit.sh, which counts IL warnings, sets it off. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.fs" />
    <Compile Include="Queries.fs" />
    <Compile Include="CaseFieldQueries.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm.Aot.Domain/Plasm.Aot.Domain.fsproj" />
    <ProjectReference Include="../../src/Plasm/Plasm.fsproj" />
    <ProjectReference Include="../../src/Plasm.Postgres/Plasm.Postgres.fsproj" />
  </ItemGroup>
  <!-- Plasm's targets, from this repository rather than the package. -->
  <Import Project="../../src/Plasm/build/Plasm.Repository.targets" />
</Project>
