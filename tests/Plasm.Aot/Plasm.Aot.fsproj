<Project Sdk="Microsoft.NET.Sdk">
  <!-- The native-AOT check (docs/aot.md): run.sh runs this program under the
       runtime and as a native binary, and compares what the two print. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL warnings are made errors last, once the binary works (docs/aot.md). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.fs" />
    <Compile Include="Queries.fs" />
    <Compile Include="CaseFieldQueries.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm.Aot.Domain/Plasm.Aot.Domain.fsproj" />
    <ProjectReference Include="../../src/Plasm/Plasm.fsproj" />
    <ProjectReference Include="../../src/Plasm.Postgres/Plasm.Postgres.fsproj" />
  </ItemGroup>
  <!-- Plasm's targets, from this repository rather than the package. -->
  <Import Project="../../src/Plasm/build/Plasm.Repository.targets" />
</Project>
