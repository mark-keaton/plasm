<Project Sdk="Microsoft.NET.Sdk">
  <!-- An application on SQLite that takes Plasm from its packages alone
       (tests/Plasm.Package/run.sh copies it outside the repository and
       restores Plasm only from a local feed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Plasm.Sqlite" Version="$(PlasmVersion)" />
  </ItemGroup>
</Project>
