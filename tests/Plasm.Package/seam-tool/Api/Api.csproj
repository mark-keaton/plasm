<Project Sdk="Microsoft.NET.Sdk">
  <!-- A C# host whose side of the data layer the seam writes (Seam.cs, and
       Seam/ after a build), published natively. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Shop.Api</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Warnings are not errors here: a switch that misses a case is an error
         all the same, because Plasm.CSharp's package makes CS8509 one. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Data/Data.fsproj" />
  </ItemGroup>
</Project>
