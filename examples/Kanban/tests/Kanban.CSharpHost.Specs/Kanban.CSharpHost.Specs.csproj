<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# host's scenarios (features/csharp/*.feature), with C# steps.
       Each scenario starts the host as its own process and talks to it over
       HTTP: the built host by default, or the program KANBAN_CSHARP_HOST
       names (a native binary of it). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ReqnrollFeatureFiles Include="../../features/csharp/*.feature" />
    <None Include="../../features/csharp/*.feature" Link="Features/%(Filename)%(Extension)" />
    <Compile Include="../Hosting/Hosting.cs" Link="Hosting.cs" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The host is run from its own output, on the packages its own build
         resolved, not on this project's (which has the F# server's). The
         scenarios read it from this assembly; tests/Hosting/no-leftover-hosts.sh
         asks MSBuild for it, so both look in one place. -->
    <KanbanHostOutput>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'src', 'Host.CSharp', 'bin', '$(Configuration)', '$(TargetFramework)'))</KanbanHostOutput>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HostOutput</_Parameter1>
      <_Parameter2>$(KanbanHostOutput)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ApplicationFSharpCore</_Parameter1>
      <_Parameter2>$(ApplicationFSharpCoreVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host is run, not called, from its own output: it is built first,
         but neither its assembly nor its packages come here. This project has
         the F# server's FSharp.Core (Fable.Remoting's), the host its own. -->
    <ProjectReference Include="../../src/Host.CSharp/Kanban.Host.CSharp.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" />
    <!-- Only for the F# server's migrations (Kanban.Server.Database.migrate); its
         ASP.NET Core packages come from the shared framework, as for Kanban.Specs. -->
    <ProjectReference Include="../../src/Server/Server.fsproj" />
    <!-- The data layer, which the sandbox scenarios call through their own seam (Seam.cs). -->
    <ProjectReference Include="../../src/Data/Kanban.Data.fsproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- The seam (Seam.cs), from this repository rather than the package. -->
  <Import Project="../../../../src/Plasm.CSharp/build/Plasm.CSharp.Repository.targets" />
</Project>
