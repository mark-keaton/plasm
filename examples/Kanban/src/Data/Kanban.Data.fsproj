<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the server stores and does, as values (Db.fs, Workflows.fs), and
       KanbanData, the type a C# host calls (Facade.fs). Both hosts reference
       this library: the F# server for the queries and workflows, the C# host
       for the facade. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Db.fs" />
    <Compile Include="Workflows.fs" />
    <Compile Include="Facade.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.fsproj" />
    <ProjectReference Include="../../../../src/Plasm/Plasm.fsproj" />
    <ProjectReference Include="../../../../src/Plasm.Postgres/Plasm.Postgres.fsproj" />
  </ItemGroup>
</Project>
