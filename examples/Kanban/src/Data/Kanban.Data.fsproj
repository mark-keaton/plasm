<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the server stores and does, as values (Db.fs, Workflows.fs);
       Boards, the type a C# host calls through the seam (Boards.fs); and
       CardQueries, the projection a GraphQL host reads (CardQueries.fs). The
       F# server references this library for the queries and workflows, the
       C# hosts for Boards. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The facade is the null boundary: F# checks nullness here (docs/csharp.md). -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Db.fs" />
    <Compile Include="Workflows.fs" />
    <Compile Include="Boards.fs" />
    <Compile Include="CardQueries.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.fsproj" />
    <ProjectReference Include="../../../../src/Plasm/Plasm.fsproj" />
    <ProjectReference Include="../../../../src/Plasm.Postgres/Plasm.Postgres.fsproj" />
    <ProjectReference Include="../../../../src/Plasm.CSharp/Plasm.CSharp.fsproj" />
  </ItemGroup>
</Project>
