<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A C# host over Kanban's F# domain and data code: minimal APIs on the
       slim builder, calling the C# the seam writes over one F# type (Kanban.Data.Boards). -->
  <PropertyGroup>
    <AssemblyName>Kanban.Host.CSharp</AssemblyName>
    <RootNamespace>Kanban.Host.CSharp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- FSharp.Core's two summary warnings, which no F# library can quiet for
         its users (docs/aot.md). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Data/Kanban.Data.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The FSharp.Core a new project gets, not the 10.1 the F# server is held
         to: Fable.Remoting holds it there, and this project does not reach
         Fable.Remoting (Directory.Packages.props). Not private: a private
         package is left out of the publish, and the native compiler would
         not find FSharp.Core. -->
    <PackageReference Include="FSharp.Core" VersionOverride="$(ApplicationFSharpCoreVersion)" />
  </ItemGroup>
  <!-- Plasm's targets, from this repository rather than the package. -->
  <Import Project="../../../../src/Plasm/build/Plasm.Repository.targets" />
  <!-- The seam (Seam.cs), from this repository rather than the package. -->
  <Import Project="../../../../src/Plasm.CSharp/build/Plasm.CSharp.Repository.targets" />
</Project>
