<Project Sdk="Microsoft.NET.Sdk">
  <!-- The domain and the API contract. This project compiles for .NET (the
       server) and to JavaScript (the client), so it references only FSharp.Core
       and Plasm.Annotations: attribute classes, which Fable compiles from source. -->
  <ItemGroup>
    <!-- Explicit, because Fable does not see the SDK's implicit reference under central package management. -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Plasm.Annotations/Plasm.Annotations.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>
</Project>
