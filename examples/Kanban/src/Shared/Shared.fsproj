<Project Sdk="Microsoft.NET.Sdk">
  <!-- The domain and the API contract. No package but FSharp.Core: this
       project compiles for .NET (the server) and to JavaScript (the client). -->
  <ItemGroup>
    <!-- Explicit, because Fable does not see the SDK's implicit reference under central package management. -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>
</Project>
