<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Kanban's host as an application would write it: ASP.NET Core with
       cookie sign-in, REST and GraphQL (Hot Chocolate) over the C# the seam
       writes from one F# type, Kanban.Data.Boards, and GraphQL's projection,
       Kanban.Data.CardQueries. Runtime only: Hot Chocolate does not start
       natively; Host.CSharp is the native proof (docs/kanban-host.md). -->
  <PropertyGroup>
    <AssemblyName>Kanban.Host</AssemblyName>
    <RootNamespace>Kanban.Host</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Data/Kanban.Data.fsproj" />
    <ProjectReference Include="../../../../src/Plasm.HotChocolate/Plasm.HotChocolate.fsproj" />
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
  </ItemGroup>
  <!-- The seam (Seam.cs), from this repository rather than the package. -->
  <Import Project="../../../../src/Plasm.CSharp/build/Plasm.CSharp.Repository.targets" />
</Project>
