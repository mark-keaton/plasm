<?xml version="1.0" encoding="utf-8"?>
<!-- Plasm's packages from packages/ (where `dotnet pack` puts them until they
     are published), everything else from nuget.org. Restored into
     .nuget/packages, not the machine's cache, so a package packed again under
     the same version is not shadowed by the copy restored before. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Plasm" />
      <package pattern="Plasm.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
