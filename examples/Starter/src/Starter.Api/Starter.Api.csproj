<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Minimal APIs over BookingData. A native binary: `dotnet publish -r <rid>`.
       Before its C# is compiled, the seam (Plasm.CSharp) writes Seam/*.g.cs
       from Starter.Data as Seam.cs says, and keeps seam.lock. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- FSharp.Core's two summary warnings, which no F# library can quiet for
         its users. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <!--#if (STARTER_SWITCH) -->
  <!-- Built for SQLite, this copy's contract has more members: its own lock. -->
  <PropertyGroup Condition='$(StarterSqlite)'>
    <PlasmSeamLock>$(MSBuildProjectDirectory)/seam.sqlite.lock</PlasmSeamLock>
  </PropertyGroup>
  <!--#endif -->
  <ItemGroup>
    <ProjectReference Include="../Starter.Data/Starter.Data.fsproj" />
  </ItemGroup>
</Project>
