<Project Sdk="Microsoft.NET.Sdk">
  <!-- The domain and everything Plasm does with it. The API and the tests
       reference only this project, and call one type: BookingData. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Its /// comments: the seam carries them into the C# it writes. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="BookingData.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- What C# is given: Found, Added and Changed, and their cases. -->
    <PackageReference Include="Plasm.CSharp" />
    <!--#if (STARTER_SQLITE) -->
    <PackageReference Include="Plasm.Sqlite" Condition='$(StarterSqlite)' />
    <!--#else -->
    <PackageReference Include="Plasm.Postgres" Condition='!$(StarterSqlite)' />
    <!--#endif -->
  </ItemGroup>
</Project>
