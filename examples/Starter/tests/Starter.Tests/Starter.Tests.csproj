<Project Sdk="Microsoft.NET.Sdk">
  <!-- BookingData's tests, each in a sandbox over one PostgreSQL started for
       the run (Docker). PublishAot: they also run as a native binary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Starter.Data/Starter.Data.fsproj" />
  </ItemGroup>
</Project>
