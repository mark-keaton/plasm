<Project Sdk="Microsoft.NET.Sdk">
  <!--#if (STARTER_SQLITE) -->
  <!-- BookingData's tests, each in a sandbox over one SQLite file made for
       the run. PublishAot: they also run as a native binary. -->
  <!--#else -->
  <!-- BookingData's tests, each in a sandbox over one PostgreSQL started for
       the run (Docker). PublishAot: they also run as a native binary. -->
  <!--#endif -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
    <!--#if (!STARTER_SQLITE) -->
    <PackageReference Include="Testcontainers.PostgreSql" Condition='!$(StarterSqlite)' />
    <!--#endif -->
  </ItemGroup>
  <ItemGroup>
    <!-- The API, whose build writes the C# BookingData (Seam/) the tests call. -->
    <ProjectReference Include="../../src/Starter.Api/Starter.Api.csproj" />
  </ItemGroup>
</Project>
