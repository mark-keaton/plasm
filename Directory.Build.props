<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- The repository root, so projects copied elsewhere in the tree (koans checks) still resolve references. -->
    <PlasmRoot>$(MSBuildThisFileDirectory)</PlasmRoot>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarnOn>3390</WarnOn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Only the libraries under src/ are packaged (src/Directory.Build.props opts in). -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <GenerateDocumentationFile Condition="'$(IsPackable)' == 'true'">true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
