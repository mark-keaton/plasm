<Project>
  <ItemGroup>
    <!-- What everything that runs Plasm as an application runs on: the .NET 11
         SDK's FSharp.Core, as a new project gets it. What the packages are built
         against is the floor, $(PlasmFSharpCoreFloor) in Directory.Build.props
         (docs/status.md). -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Plasm.HotChocolate is built against this version (docs/hotchocolate.md). -->
    <PackageVersion Include="HotChocolate.Data" Version="16.7.6" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.7.6" />
    <PackageVersion Include="HotChocolate.Types.OffsetPagination" Version="16.7.6" />
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="FSharp.Compiler.Service" Version="43.13.101" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
  </ItemGroup>
</Project>
