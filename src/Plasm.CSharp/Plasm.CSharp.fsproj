<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>What a C# host is given by an F# data layer on Plasm: the cases it switches over (Missing, Refused, Stale, Invalid), the unions of them in C#'s union shape (Found, Added, Answered, Changed), the functions that read a result as one, and a base for a union's JSON classifier.</Description>
    <PackageId>Plasm.CSharp</PackageId>
    <!-- Either provider: the package names no database. -->
    <PackageTags>fsharp;csharp;orm;ecto;database;persistence;aot</PackageTags>
    <!-- Trim and AOT analysis at every build, as Plasm's (docs/aot.md). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Cases.fs" />
    <Compile Include="Outcome.fs" />
    <Compile Include="ByKind.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Seam.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm/Plasm.fsproj" />
    <!-- The seam tool, built first and carried in tools/seam/: neither a
         reference of Plasm.CSharp nor a dependency of its package. -->
    <ProjectReference Include="../Plasm.Seam/Plasm.Seam.fsproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- The analyzer, built first and carried in analyzers/dotnet/cs/. -->
    <ProjectReference Include="../Plasm.Seam.Analyzers/Plasm.Seam.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <!-- The seam's build targets, for a C# host (buildTransitive/Plasm.CSharp.targets). -->
  <ItemGroup>
    <None Include="build/Plasm.CSharp.targets" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/Plasm.CSharp.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- seam.lock's format, its grammar and promises, for a developer offline:
         the same file as the site's page (docs/seam-lock.md). -->
    <None Include="../../docs/seam-lock.md" Pack="true" PackagePath="docs/seam-lock.md" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PlasmSeamToolInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <!-- The tool as built, beside its dependencies, runtimeconfig and deps.json:
       a build runs it with the dotnet that builds the host. And the analyzer,
       which the C# compiler runs in any C# project that has the package. -->
  <Target Name="PlasmSeamToolInPackage">
    <MSBuild Projects="../Plasm.Seam/Plasm.Seam.fsproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_PlasmSeamToolPath" />
    </MSBuild>
    <MSBuild Projects="../Plasm.Seam.Analyzers/Plasm.Seam.Analyzers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_PlasmSeamAnalyzer" />
    </MSBuild>
    <PropertyGroup>
      <_PlasmSeamToolDir>@(_PlasmSeamToolPath->'%(RootDir)%(Directory)')</_PlasmSeamToolDir>
    </PropertyGroup>
    <ItemGroup>
      <_PlasmSeamToolFile Include="$(_PlasmSeamToolDir)*.dll;$(_PlasmSeamToolDir)Plasm.Seam.runtimeconfig.json;$(_PlasmSeamToolDir)Plasm.Seam.deps.json" />
      <TfmSpecificPackageFile Include="@(_PlasmSeamToolFile)" PackagePath="tools/seam/%(Filename)%(Extension)" />
      <TfmSpecificPackageFile Include="@(_PlasmSeamAnalyzer)" PackagePath="analyzers/dotnet/cs/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="!Exists('$(_PlasmSeamToolDir)Plasm.Seam.dll')" Text="the seam tool is not built at $(_PlasmSeamToolDir): build Plasm.CSharp first" />
  </Target>
</Project>
