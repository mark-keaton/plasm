<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The attributes a record uses to say how Plasm stores it: Table, Unique, Version, Generated, Assigned, NotReference, OrderedBy and JoinTable. No dependencies beyond FSharp.Core, and compiled by Fable from its sources, so a domain shared with a browser client can carry them. Experimental.</Description>
    <PackageId>Plasm.Annotations</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Annotations.fs" />
  </ItemGroup>
  <!-- Fable compiles F# sources, not assemblies: the package carries them in
       fable/, and not what a build writes under obj/ and bin/. -->
  <ItemGroup>
    <Content Include="*.fsproj; **/*.fs" Exclude="obj/**; bin/**" PackagePath="fable/" />
  </ItemGroup>
</Project>
