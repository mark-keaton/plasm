<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dotnet new plasm-api`: examples/Starter as a template. Its content is the
       Starter's own files, taken at pack time, so there is no copy to keep in
       step; tests/Plasm.Package checks the package's files against the
       Starter's and builds a project made from it. -->
  <PropertyGroup>
    <PackageId>Plasm.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Description>dotnet new plasm-api: an F# domain and its data access on Plasm.Postgres (or, with --database sqlite, Plasm.Sqlite), a C# minimal API that publishes with native AOT, and C# tests, each in a sandbox.</Description>
    <PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The Starter's .gitignore is part of it. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: a template has no lib/ to match its dependency groups. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Starter>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'examples', 'Starter'))</Starter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="FSharp.Core" />
    <None Include="$(Starter)**" Exclude="$(Starter)**/bin/**;$(Starter)**/obj/**;$(Starter)**/TestResults/**;$(Starter)packages/**;$(Starter).nuget/**" Pack="true" PackagePath="content/Starter/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- template.json, with the Starter's Plasm.Postgres version (the text the
       template replaces) and the template's own (what replaces it): a project
       made from Plasm.Templates X references Plasm.Postgres X, or Plasm.Sqlite
       X when the database chosen is SQLite. -->
  <Target Name="PlasmTemplateConfig" BeforeTargets="_GetPackageFiles">
    <XmlPeek XmlInputPath="$(Starter)Directory.Packages.props" Query="/Project/ItemGroup/PackageVersion[@Include='Plasm.Postgres']/@Version">
      <Output TaskParameter="Result" PropertyName="StarterPlasmVersion" />
    </XmlPeek>
    <Error Condition="'$(StarterPlasmVersion)' == ''" Text="examples/Starter/Directory.Packages.props names no Plasm.Postgres version." />
    <XmlPeek XmlInputPath="$(Starter)Directory.Packages.props" Query="/Project/ItemGroup/PackageVersion[@Include='Plasm.Sqlite']/@Version">
      <Output TaskParameter="Result" PropertyName="StarterSqliteVersion" />
    </XmlPeek>
    <!-- One version replaces both: the Starter names Plasm.Sqlite at Plasm.Postgres's. -->
    <Error Condition="'$(StarterSqliteVersion)' != '$(StarterPlasmVersion)'" Text="examples/Starter/Directory.Packages.props names Plasm.Sqlite at '$(StarterSqliteVersion)', not at Plasm.Postgres's $(StarterPlasmVersion)." />
    <!-- MSBuild writes a backslash as a slash: template.json must have none. -->
    <Error Condition="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)template.json').Contains('\'))" Text="src/Plasm.Templates/template.json has a backslash, which the copy packed would turn into a slash." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)template.json').Contains('@VERSION@'))" Text="src/Plasm.Templates/template.json has lost its @VERSION@ placeholder." />
    <PropertyGroup>
      <!-- Set here, not in the project's body, where IntermediateOutputPath is
           still empty: there it named template.json itself, its source. -->
      <TemplateConfig>$(BaseIntermediateOutputPath)plasm-template/template.json</TemplateConfig>
      <TemplateJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)template.json').Replace('@STARTER_VERSION@', '$(StarterPlasmVersion)').Replace('@VERSION@', '$(PackageVersion)'))</TemplateJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(TemplateConfig)" Lines="$(TemplateJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(TemplateConfig)" Pack="true" PackagePath="content/Starter/.template.config/template.json" />
    </ItemGroup>
  </Target>
</Project>
