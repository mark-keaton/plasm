<Project>
  <!-- Plasm's targets for a project in this repository (docs/aot.md): the
       targets the package will carry, with src/Plasm.FieldGetters built here,
       as a plain program in its own output folder whatever the importing
       build's output, runtime or publish settings, and run from there. -->
  <PropertyGroup>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <!-- So that a restore of the importing project restores the tool too; it is
         built and run by the target below, not referenced. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../Plasm.FieldGetters/Plasm.FieldGetters.fsproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Import Project="Plasm.targets" />
  <Target Name="PlasmFieldGettersTool" BeforeTargets="PlasmFieldGetters" Condition="'$(PublishAot)' == 'true' and '$(PlasmFieldGetters)' != 'false'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../Plasm.FieldGetters/Plasm.FieldGetters.fsproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="OutputPath;OutDir;RuntimeIdentifier;SelfContained;PublishAot;_PublishingToolOutput">
      <Output TaskParameter="TargetOutputs" PropertyName="PlasmFieldGettersTool" />
    </MSBuild>
  </Target>
</Project>
