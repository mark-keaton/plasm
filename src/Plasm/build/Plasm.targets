<Project>
  <!-- Plasm in a native binary (docs/aot.md): reflection reads an application's
       records and unions, and a query names its functions, so the
       application's assembly and those of its project references are kept
       whole when a publish trims. Plasm's own assemblies keep what queries
       name through the descriptor in Plasm.dll. Nothing changes for a build
       that does not trim. -->
  <Target Name="PlasmRoots" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_PlasmOwn Include="Plasm;Plasm.Annotations;Plasm.Postgres;Plasm.PGlite" />
      <_PlasmReferenced Include="@(ReferencePath->'%(Filename)')" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
      <_PlasmReferenced Remove="@(_PlasmOwn)" />
      <TrimmerRootAssembly Include="$(AssemblyName)" />
      <TrimmerRootAssembly Include="@(_PlasmReferenced)" />
    </ItemGroup>
  </Target>
</Project>
