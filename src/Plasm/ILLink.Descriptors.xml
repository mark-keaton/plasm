<!-- What a native binary keeps for the queries Plasm translates (docs/aot.md):
     a query is a quotation, read back at run time, and every type and method
     it names must survive trimming, the ones the translator recognises and
     the ones a quotation names around them (Plasm's own builder, a prepared
     query's argument, a scalar's members). Unit tests fail when the
     translator names a type not kept here, or a scalar type Plasm maps is
     not kept whole (tests/Plasm.Tests/TrimDescriptor.fs). -->
<linker>
  <assembly fullname="FSharp.Core">
    <type fullname="Microsoft.FSharp.Core.Operators" preserve="methods" />
    <type fullname="Microsoft.FSharp.Core.LanguagePrimitives" preserve="methods" />
    <type fullname="Microsoft.FSharp.Core.LanguagePrimitives/IntrinsicFunctions" preserve="methods" />
    <type fullname="Microsoft.FSharp.Core.LanguagePrimitives/HashCompare" preserve="methods" />
    <type fullname="Microsoft.FSharp.Core.OptionModule" preserve="methods" />
    <type fullname="Microsoft.FSharp.Collections.ListModule" preserve="methods" />
    <type fullname="Microsoft.FSharp.Collections.SeqModule" preserve="methods" />
    <type fullname="Microsoft.FSharp.Collections.ArrayModule" preserve="methods" />
    <type fullname="Microsoft.FSharp.Core.FSharpOption`1" preserve="all" />
    <type fullname="Microsoft.FSharp.Collections.FSharpList`1" preserve="all" />
    <!-- The decoder of [<ReflectedDefinition>] bodies, which Plasm calls by
         name in a native binary (Definitions in src/Plasm/Shapes.fs). -->
    <type fullname="Microsoft.FSharp.Quotations.PatternsModule" preserve="all">
      <type name="BindingEnv" preserve="all" />
      <type name="SimpleUnpickle" preserve="all" />
    </type>
    <type fullname="Microsoft.FSharp.Core.FSharpFunc`2" preserve="methods" />
  </assembly>
  <assembly fullname="System.Private.CoreLib">
    <!-- The scalar types Plasm maps (Scalar.builtIn), whose members a query
         may call. -->
    <type fullname="System.Int16" preserve="all" />
    <type fullname="System.Int32" preserve="all" />
    <type fullname="System.Int64" preserve="all" />
    <type fullname="System.String" preserve="all" />
    <type fullname="System.Boolean" preserve="all" />
    <type fullname="System.Decimal" preserve="all" />
    <type fullname="System.Double" preserve="all" />
    <type fullname="System.Single" preserve="all" />
    <type fullname="System.Guid" preserve="all" />
    <type fullname="System.DateTime" preserve="all" />
    <type fullname="System.DateTimeOffset" preserve="all" />
    <type fullname="System.DateOnly" preserve="all" />
    <type fullname="System.TimeOnly" preserve="all" />
    <type fullname="System.TimeSpan" preserve="all" />
    <type fullname="System.Byte" preserve="all" />
    <!-- A tuple a query selects is made by setting its fields (Shape.tuple). -->
    <type fullname="System.Tuple`1" preserve="fields" />
    <type fullname="System.Tuple`2" preserve="fields" />
    <type fullname="System.Tuple`3" preserve="fields" />
    <type fullname="System.Tuple`4" preserve="fields" />
    <type fullname="System.Tuple`5" preserve="fields" />
    <type fullname="System.Tuple`6" preserve="fields" />
    <type fullname="System.Tuple`7" preserve="fields" />
    <type fullname="System.Tuple`8" preserve="fields" />
    <type fullname="System.ValueTuple`1" preserve="fields" />
    <type fullname="System.ValueTuple`2" preserve="fields" />
    <type fullname="System.ValueTuple`3" preserve="fields" />
    <type fullname="System.ValueTuple`4" preserve="fields" />
    <type fullname="System.ValueTuple`5" preserve="fields" />
    <type fullname="System.ValueTuple`6" preserve="fields" />
    <type fullname="System.ValueTuple`7" preserve="fields" />
    <type fullname="System.ValueTuple`8" preserve="fields" />
  </assembly>
  <!-- Plasm whole: its builder, its query functions and a prepared query's
       arguments are named by quotations that nothing else calls. -->
  <assembly fullname="Plasm" preserve="all" />
</linker>
