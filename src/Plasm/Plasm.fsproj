<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Persistence for F# that stores the domain's own records: conventions for scalars and unions, owned and linked lists loaded with their owner, compiler-checked queries, typed transactions. Experimental.</Description>
    <PackageId>Plasm</PackageId>
    <!-- FS3370 informational; FS0064 from generic constraints in builders is intentional -->
    <NoWarn>$(NoWarn);FS3370</NoWarn>
    <!-- Without Trimming.fs's suppressions, for tests/Plasm.Aot/trim-audit.sh. -->
    <DefineConstants Condition="'$(PlasmTrimAudit)' == 'true'">$(DefineConstants);PLASM_TRIM_AUDIT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Trimming.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="Reflection.fs" />
    <Compile Include="Computed.fs" />
    <Compile Include="Scalar.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="Stored.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Sql.fs" />
    <Compile Include="Query.fs" />
    <Compile Include="BuildQuery.fs" />
    <Compile Include="Translate.fs" />
    <Compile Include="Plan.fs" />
    <Compile Include="Changeset.fs" />
    <Compile Include="Provider.fs" />
    <Compile Include="Sandbox.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="Writes.fs" />
    <Compile Include="Bulk.fs" />
    <Compile Include="SchemaCheck.fs" />
    <Compile Include="Scaffold.fs" />
    <Compile Include="Tx.fs" />
    <Compile Include="Repo.fs" />
    <Compile Include="Interactive.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read by the trimmer of a native binary (docs/aot.md). -->
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm.Annotations/Plasm.Annotations.fsproj" />
  </ItemGroup>
  <!-- What the package carries for a native binary (docs/aot.md): the targets,
       imported by an application that references Plasm (build/) or a package
       that does (buildTransitive/), and the field-getter tool they run
       (tools/, beside them as build/Plasm.targets expects). In this
       repository, build/Plasm.Repository.targets builds and runs the tool
       instead. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PlasmPackFieldGetters</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build/Plasm.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <Target Name="PlasmPackFieldGetters">
    <PropertyGroup>
      <_PlasmTool>$(MSBuildThisFileDirectory)../Plasm.FieldGetters/Plasm.FieldGetters.fsproj</_PlasmTool>
    </PropertyGroup>
    <!-- Built even under pack's no-build (as CI packs, after the solution's
         build, where it is up to date): NoBuild is the package's, not the tool's. -->
    <MSBuild Projects="$(_PlasmTool)" Targets="Restore" Properties="Configuration=$(Configuration);_PlasmToolRestore=true" RemoveProperties="NoBuild" />
    <MSBuild Projects="$(_PlasmTool)" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="OutputPath;OutDir;RuntimeIdentifier;SelfContained;PublishAot;NoBuild">
      <Output TaskParameter="TargetOutputs" ItemName="_PlasmToolAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_PlasmToolDirectory>@(_PlasmToolAssembly->'%(RootDir)%(Directory)')</_PlasmToolDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_PlasmToolFile Include="$(_PlasmToolDirectory)*.dll;$(_PlasmToolDirectory)Plasm.FieldGetters.runtimeconfig.json;$(_PlasmToolDirectory)Plasm.FieldGetters.deps.json" />
      <TfmSpecificPackageFile Include="@(_PlasmToolFile)" PackagePath="tools/" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Plasm.Postgres" />
    <InternalsVisibleTo Include="Plasm.Tests" />
    <InternalsVisibleTo Include="Plasm.Aot" />
    <InternalsVisibleTo Include="Plasm.Specs.Steps" />
    <InternalsVisibleTo Include="Plasm.TestDomain" />
  </ItemGroup>
</Project>
