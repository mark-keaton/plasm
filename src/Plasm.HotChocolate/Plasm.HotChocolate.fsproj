<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Hot Chocolate over Plasm: GraphQL filter and sort input types generated from fields declared in F#, and the where and order a request gives applied in the database. Experimental.</Description>
    <PackageId>Plasm.HotChocolate</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Schema.fs" />
    <Compile Include="Providers.fs" />
    <Compile Include="Request.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm/Plasm.fsproj" />
    <PackageReference Include="HotChocolate.Data" />
    <PackageReference Include="HotChocolate.Types.OffsetPagination" />
  </ItemGroup>
</Project>
