<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>SQLite provider for Plasm (Microsoft.Data.Sqlite).</Description>
    <PackageId>Plasm.Sqlite</PackageId>
    <!-- The shared tags, with SQLite's name in place of PostgreSQL's. -->
    <PackageTags>fsharp;csharp;orm;ecto;database;sqlite;persistence;aot</PackageTags>
    <!-- Trim and AOT analysis at every build, as Plasm's (docs/aot.md). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Decimals.fs" />
    <Compile Include="Windows.fs" />
    <Compile Include="Times.fs" />
    <Compile Include="Lists.fs" />
    <Compile Include="ForeignKeys.fs" />
    <Compile Include="Connection.fs" />
    <Compile Include="Sqlite.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plasm/Plasm.fsproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Plasm.Tests" />
    <InternalsVisibleTo Include="Plasm.Aot.Sqlite" />
  </ItemGroup>
</Project>
